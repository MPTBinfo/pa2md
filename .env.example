# Copy to .env.local for local development. Replace every placeholder.
# Never commit .env.local or real credentials.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use the service-account private key with literal \n sequences if your host requires it.
GOOGLE_PRIVATE_KEY=
# Generate a random secret of at least 32 characters.
SESSION_SECRET=
OFFICE_ADMIN_EMAIL=
OFFICE_ADMIN_PASSWORD=
# Optional public logo URL; not a secret.
NEXT_PUBLIC_MPTB_LOGO_URL=
